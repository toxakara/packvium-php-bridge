{
  "name": "packvium/native-bridge",
  "description": "Optional FFI backend for Packvium with pure-PHP fallback",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Packvium contributors",
      "homepage": "https://packvium.com"
    }
  ],
  "keywords": ["3d-bin-packing", "cartonization", "container-loading", "packing", "ffi"],
  "homepage": "https://packvium.com",
  "support": {
    "issues": "https://github.com/toxakara/packvium-php-bridge/issues",
    "source": "https://github.com/toxakara/packvium-php-bridge"
  },
  "require": {"php": ">=7.4"},
  "require-dev": {"packvium/packvium": "^1.0"},
  "suggest": {
    "ext-ffi": "Loads the Rust shared library",
    "packvium/packvium": "Provides the pure-PHP fallback"
  },
  "autoload": {"psr-4": {"Packvium\\Native\\": "src/"}},
  "scripts": {"test": "php tests/run.php"}
}
